# Normalize line endings for text files; keep binaries untouched.
* text=auto

*.md    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.docx  binary
*.npz   binary